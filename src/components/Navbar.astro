---
export interface Props {
  current?: "home" | "blog";
}
const { current = "home" } = Astro.props;
---

<div
  class="navbar w-nav"
  data-animation="default"
  data-collapse="none"
  data-duration="400"
  data-easing="ease"
  data-easing2="ease"
  role="banner"
>
  <div class="padding-global">
    <div class="nav_container">
      {current === "home" ? (
        <a aria-current="page" class="nav_logo w-nav-brand w--current" href="/">
          <img alt="jellypop" class="image-cover" loading="lazy" src="/images/jelly-pop-logo.png" />
        </a>
      ) : (
        <a class="nav_logo w-nav-brand" href="/">
          <img alt="jellypop" class="image-cover" loading="lazy" src="/images/jelly-pop-logo.png" />
        </a>
      )}
      <nav class="nav_menu_wrapper w-nav-menu" role="navigation">
        <div class="nav_menu">
          <div class="nav-badge-wrapper hide-mobile-landscape">
            <a class="nav_link w-nav-link" href="https://bit.ly/4kKzjwy" target="_blank">Our Work</a>
            <div class="nav_badge">NEW</div>
          </div>
          <a class="nav_link hide-mobile-landscape w-nav-link" href="/#our-services">Our Services</a>
          {current === "blog" ? (
            <a aria-current="page" class="nav_link hide-mobile-landscape w-nav-link w--current" href="/blog">Blog</a>
          ) : (
            <a class="nav_link hide-mobile-landscape w-nav-link" href="/blog">Blog</a>
          )}
        </div>
        <div class="nav_button-tip_wrapper">
          <a class="button is-navbar w-button" href="/#cta-section">Book A Call</a>
          <div class="nav_button-tip-absolute">
            <div class="text-size-small text-style-italic">⚡ Get Instant Response</div>
          </div>
        </div>
      </nav>
      <div class="w-nav-button">
        <div class="w-icon-nav-menu"></div>
      </div>
    </div>
  </div>
</div>
