---
export interface Props {
  pageId: string; // Webflow's per-page ID, for data-wf-page-id on the form
}
const { pageId } = Astro.props;
---

<div
  class="popup_block"
  fs-modal-display="flex"
  fs-modal-element="modal"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
>
  <div class="popup_form_wrapper background-color-white">
    <!-- <h2 class="heading-style-h3 text-color-1f1f1f text-align-center">
      Please enter your details
    </h2>
    <div class="padding-bottom padding-large"></div> -->
    <div class="saas_form-block w-form">
      <iframe
        src="https://zcal.co/theharshmak09/clarity-call/contact"
        style="width: 100%; min-height: 900px; overflow: auto; border: none;"
        loading="lazy"></iframe>
    </div>
    <div
      class="popup_close w-embed"
      fs-modal-element="close"
      data-popup-close=""
      role="button"
      tabindex="0"
      aria-label="Close popup"
    >
      <svg
        fill="none"
        height="auto"
        viewbox="0 0 24 24"
        width="auto"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="M19.5459 17.954C19.7572 18.1653 19.876 18.452 19.876 18.7509C19.876 19.0497 19.7572 19.3364 19.5459 19.5477C19.3346 19.7591 19.0479 19.8778 18.749 19.8778C18.4501 19.8778 18.1635 19.7591 17.9521 19.5477L12 13.5937L6.0459 19.5459C5.83455 19.7572 5.54791 19.8759 5.24902 19.8759C4.95014 19.8759 4.66349 19.7572 4.45215 19.5459C4.2408 19.3345 4.12207 19.0479 4.12207 18.749C4.12207 18.4501 4.2408 18.1635 4.45215 17.9521L10.4062 11.9999L4.45402 6.04586C4.24268 5.83451 4.12395 5.54787 4.12395 5.24898C4.12395 4.9501 4.24268 4.66345 4.45402 4.45211C4.66537 4.24076 4.95201 4.12203 5.2509 4.12203C5.54978 4.12203 5.83643 4.24076 6.04777 4.45211L12 10.4062L17.954 4.45117C18.1654 4.23983 18.452 4.12109 18.7509 4.12109C19.0498 4.12109 19.3364 4.23983 19.5478 4.45117C19.7591 4.66251 19.8778 4.94916 19.8778 5.24804C19.8778 5.54693 19.7591 5.83358 19.5478 6.04492L13.5937 11.9999L19.5459 17.954Z"
          fill="currentColor"></path>
      </svg>
    </div>
  </div>
  <div
    class="saas_form_background"
    data-w-id="36ff61c2-52ea-f31e-7458-096d8fa45aab"
    fs-modal-element="close"
    data-popup-close=""
  >
  </div>
</div>

<style is:global>
  .popup_block {
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  .popup_block.is-open {
    opacity: 1;
  }
  .popup_close,
  .saas_form_background {
    cursor: pointer;
  }
  body.popup-open {
    overflow: hidden;
  }
</style>

<script is:inline>
  (function () {
    function init() {
      var popup = document.querySelector(".popup_block");
      if (!popup || popup.dataset.popupReady) return;
      popup.dataset.popupReady = "true";
      var lastTrigger = null;

      function openPopup(trigger) {
        lastTrigger = trigger || null;
        popup.style.display = "flex";
        popup.setAttribute("aria-hidden", "false");
        document.body.classList.add("popup-open");
        requestAnimationFrame(function () {
          popup.classList.add("is-open");
        });
        var firstInput = popup.querySelector("input, select, textarea");
        if (firstInput)
          setTimeout(function () {
            firstInput.focus();
          }, 50);
      }

      function closePopup() {
        if (popup.style.display === "none" || !popup.style.display) return;
        popup.classList.remove("is-open");
        popup.setAttribute("aria-hidden", "true");
        document.body.classList.remove("popup-open");
        setTimeout(function () {
          popup.style.display = "none";
        }, 250);
        if (lastTrigger) lastTrigger.focus();
      }

      // Open: any element with data-popup-open (e.g. "Book a Call" in blog detail)
      document.addEventListener("click", function (e) {
        var trigger = e.target.closest("[data-popup-open]");
        if (trigger) {
          e.preventDefault();
          openPopup(trigger);
          return;
        }
        // Close: X icon or dark background overlay
        if (e.target.closest("[data-popup-close]")) {
          e.preventDefault();
          closePopup();
        }
      });

      // Close: Escape key, or Enter/Space on the focused X icon
      document.addEventListener("keydown", function (e) {
        if (e.key === "Escape") closePopup();
        if (
          (e.key === "Enter" || e.key === " ") &&
          e.target.matches &&
          e.target.matches("[data-popup-close]")
        ) {
          e.preventDefault();
          closePopup();
        }
      });

      window.openPopupForm = openPopup;
      window.closePopupForm = closePopup;
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init);
    } else {
      init();
    }
  })();
</script>
