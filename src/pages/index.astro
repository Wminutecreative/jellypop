                            loading="lazy"
                            src="/images/unlisted-assets.svg"
                          />
                        </div>
                        <div class="splide__slide">
                          <img
                            alt="cryptograd"
                            class="logo3_logo height-2rem"
                            loading="lazy"
                            src="/images/cryptograd.svg"
                          />
                        </div>
                        <div class="splide__slide">
                          <img
                            alt="confetti
  "
                            class="logo3_logo height-2rem"
                            loading="lazy"
                            src="/images/confetti-logo_1confetti-logo.webp"
                          />
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <section class="home_problems">
        <div class="padding-section-medium">
          <div class="padding-global">
            <div class="container-large">
              <div class="home_problems_wrapper">
                <div class="home_problems_card">
                  <div class="home_card_graphic">
                    <img
                      alt="Customer evaluating snack packaging on a retail shelf, showcasing the importance of shelf appeal for D2C food and FMCG brands"
                      class="image-cover"
                      loading="lazy"
                      src="/images/customers-browsing_1.avif"
                    />
                  </div>
                  <div class="home_problems_card_text-content">
                    <h2 class="heading-style-h2">
                      How many customers are browsing past your product right
                      now?
                    </h2>
                    <div class="padding-bottom padding-medium"></div>
                    <p class="heading-style-h5 text-color-1f1f1f">
                      Your product is great. But if it doesn’t look the part,
                      you’re losing. If you feel this way, then you have come at
                      the right place!
                    </p>
                  </div>
                </div>
                <div class="home_problems_card">
                  <div class="home_problems_card_text-content">
                    <h2 class="heading-style-h2">
                      The Problem<span
                        class="text-weight-normal"> (and how you solve it)</span>
                    </h2>
                    <div class="padding-bottom padding-large"></div>
                    <p class="heading-style-h5 text-color-1f1f1f">
                      Most D2C brands start with great products. But somewhere
