                    ⚡ Get Instant Response
                  </div>
                </div>
              </div>
            </nav>
            <div class="w-nav-button">
              <div class="w-icon-nav-menu"></div>
            </div>
          </div>
        </div>
      </div>
      <section class="home_hero">
        <div class="padding-section-large">
          <img
            alt=""
            class="home_hero_blob yellow-blob"
            loading="lazy"
            src="/images/yellow-blob.png"
          />
          <div class="padding-global">
            <div class="container-large">
              <div class="home_hero_wrapper">
                <h1 class="heading-style-h1">
                  We design the brands people want to touch. <span
                    class="text-weight-normal"
                    >From your box to your website, we make every pixel feel
                    iconic.</span>
                </h1>
                <img
                  alt=""
                  class="home_hero_header-blob"
                  loading="lazy"
                  src="/images/red-blob.png"
                />
                <div class="padding-bottom padding-small"></div>
                <div class="padding-bottom padding-xsmall"></div>
                <div class="home_hero_paragraph-wrapper">
                  <p
                    class="text-size-medium text-weight-normal text-color-1f1f1f"
                  >
                    For D2C brands that want to look as good as they taste,
                    feel, or wear. We help you launch iconic packaging,
                    branding, and websites that feel made-to-go-viral; without
                    the usual agency drag.
                  </p>
                </div>
                <div class="padding-bottom padding-large"></div>
                <div class="button-group">
                  <div class="button-tip" fs-modal-element="">
                    <a class="button w-button" href="#cta-section"
                      >Book A Meeting</a
                    >
                    <div
                      class="text-size-small text-style-italic text-align-center"
                    >
                      ⚡ Get Instant Response
                    </div>
                  </div>
                  <a
                    class="button is-alternate w-button"
                    href="https://bit.ly/4kKzjwy"
                    target="_blank">View Our Work</a
                  >
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
      <div class="home_logos">
        <div class="padding-section-medium">
          <div class="padding-global">
            <div class="container-large">
              <div class="home_logos_wrapper">
                <h2
                  class="heading-style-h3 text-color-1f1f1f text-align-center"
                >
                  Our team has worked with visionary brands
                </h2>
                <div class="margin-top margin-large">
                  <div class="splide auto-scroll-slider" fade="">
                    <div class="splide__track">
                      <div class="splide__list">
                        <div class="splide__slide">
                          <img
                            alt="stockpe"
                            class="logo3_logo height-2rem"
                            loading="lazy"
                            src="/images/stockpe.svg"
                          />
                        </div>
                        <div class="splide__slide">
                          <img
                            alt="bookee logo"
                            class="logo3_logo height-2rem"
                            loading="lazy"
                            src="/images/bookee-logo_1bookee-logo.webp"
                          />
                        </div>
                        <div class="splide__slide">
                          <img
                            alt="sarvam logo"
                            class="logo3_logo height-1rem"
                            loading="lazy"
                            src="/images/sarvam-logo.svg"
                          />
                        </div>
                        <div class="splide__slide">
                          <img
                            alt="hakuna matata tech logo"
                            class="logo3_logo height-2rem"
                            loading="lazy"
                            src="/images/hakuna-matata-logo_1hakuna-matata-logo.avif"
                          />
                        </div>
                        <div class="splide__slide">
                          <img
                            alt="unlisted-assets"
