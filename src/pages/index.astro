      </style>
    </div>
    <main class="main-wrapper">
      <div
        class="navbar w-nav"
        data-animation="default"
        data-collapse="none"
        data-duration="400"
        data-easing="ease"
        data-easing2="ease"
        role="banner"
      >
        <div class="padding-global">
          <div class="nav_container">
            <a
              aria-current="page"
              class="nav_logo w-nav-brand w--current"
              href="/"
              >
              <img
                alt="jellypop"
                class="image-cover"
                loading="lazy"
                src="/images/jelly-pop-logo.png"
              />
            </a
            >
            <nav class="nav_menu_wrapper w-nav-menu" role="navigation">
              <div class="nav_menu">
                <div class="nav-badge-wrapper hide-mobile-landscape">
                  <a
                    class="nav_link w-nav-link"
                    href="https://bit.ly/4kKzjwy"
                    target="_blank">Our Work</a
                  >
                  <div class="nav_badge">NEW</div>
                </div>
                <a
                  class="nav_link hide-mobile-landscape w-nav-link"
                  href="/#our-services">Our Services</a
                >
                <!-- <a
                  class="nav_link hide-mobile-landscape w-nav-link"
                  href="/blog">Blog</a
                > -->
              </div>
              <div class="nav_button-tip_wrapper">
                <a class="button is-navbar w-button" href="/#cta-section"
                  >Book A Call</a
                >
                <div class="nav_button-tip-absolute">
