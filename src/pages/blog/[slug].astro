  </svg></div>
  </a>
  <a class="content32_social-link icon-align-center w-inline-block" fs-socialshare-element="linkedin" href="#">
  <div class="icon-embed-xsmall w-embed"><svg fill="none" height="28" viewbox="0 0 28 28" width="28" xmlns="http://www.w3.org/2000/svg">
  <path clip-rule="evenodd" d="M8.53304 10.2419C9.48326 10.2419 10.2536 9.47155 10.2536 8.52132C10.2536 7.57109 9.48326 6.80078 8.53304 6.80078C7.58281 6.80078 6.8125 7.57109 6.8125 8.52132C6.8125 9.47155 7.58281 10.2419 8.53304 10.2419ZM11.8293 11.5134H14.6808V12.8197C14.6808 12.8197 15.4546 11.2721 17.5599 11.2721C19.438 11.2721 20.9938 12.1973 20.9938 15.0173V20.964H18.0389V15.7379C18.0389 14.0743 17.1507 13.8914 16.474 13.8914C15.0694 13.8914 14.829 15.1029 14.829 15.9549V20.964H11.8293V11.5134ZM10.0329 11.5134H7.0332V20.964H10.0329V11.5134Z" fill="#000714" fill-rule="evenodd"></path>
  </svg></div>
  </a>
  </div>
  </div>
  </div>
  </div>
  </div>
  </div>
  </div>
  </div>
  <footer class="component_footer">
  <div class="padding-section-medium">
  <div class="padding-global">
  <div class="container-large">
  <div class="component_footer_wrapper">
