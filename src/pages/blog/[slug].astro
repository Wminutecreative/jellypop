  <div class="global-styles">
  <div class="style-overrides w-embed">
  <style is:global>
  /* Ensure all elements inherit the color from its parent */
  a,
  .w-input,
  .w-select,
  .w-tab-link,
  .w-nav-link,
  .w-nav-brand,
  .w-dropdown-btn,
  .w-dropdown-toggle,
  .w-slider-arrow-left,
