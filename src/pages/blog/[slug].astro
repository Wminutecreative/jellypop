  <a class="summary_icon_link-block w-inline-block" href={f["gemini-link-2"]} target="_blank" rel="noopener"><img alt="Gemini logo with a star dotting the letter i on a white background." class="summary_wapper-icon" loading="lazy" src="/images/Gemini-white-bg-logo.png"/>
  <div class="summary_overlay"></div>
  </a>
  </div>
  </div>
  </div>
  </div>
  <div class="content_table mobile-version">
  <div class="margin-bottom margin-xsmall">
  <div class="content_share-text-div">
  <div class="fst-toc_text-header text-style-allcaps text-color-shade-black-50">Table of Contents</div>
