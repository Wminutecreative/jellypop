---
import Layout from "../../layouts/Layout.astro";
import {
  getBlogPosts,
  getCategories,
  getAuthors,
  getFaqs,
  resolveRefs,
} from "../../lib/content.js";

// One page is generated for every published post: /blog/<slug>
export function getStaticPaths() {
  return getBlogPosts().map((post) => ({
    params: { slug: post.fieldData.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const f = post.fieldData;

const category = resolveRefs(f["blog-categories"], getCategories())[0];
const author = resolveRefs(f["blog-authors"], getAuthors())[0];
const faqs = resolveRefs(f.faq, getFaqs());

const title = f["meta-title-seo"] || f.name;
const description = f["meta-description-seo"] || f["blog-summary-2"];
const image = f["blog-thumbnail"]?.url;
const url = `https://www.jellypop.design/blog/${f.slug}`;
---
<Layout title={title} description={description} canonicalPath={`/blog/${f.slug}`}>
  <Fragment slot="head-extra">
    <script async type="module" src="https://cdn.jsdelivr.net/npm/@finsweet/attributes@2/attributes.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/@finsweet/attributes-toc@1/toc.js"></script>
    <style is:global>
      .faq-minus.vertical { transition: transform 0.3s ease; }
      .faq_item.active .faq-minus.vertical { transform: rotate(90deg); }
    </style>
    <style is:global>
      .table-wrapper{
        width:100%;
        overflow-x:auto;
        -webkit-overflow-scrolling: touch;
      }
      .table-wrapper table{ min-width: 600px; }
    </style>
  </Fragment>


  <div class="page-wrapper">
  <div class="main-wrapper overflow-visible">
  <div class="navbar w-nav" data-animation="default" data-collapse="none" data-duration="400" data-easing="ease" data-easing2="ease" role="banner">
  <div class="padding-global">
  <div class="nav_container">
  <a class="nav_logo w-nav-brand" href="/"><img alt="jellypop" class="image-cover" loading="lazy" src="/images/jelly-pop-logo.png"/></a>
