---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import GlobalEmbeds from "../../components/GlobalEmbeds.astro";
import PopupForm from "../../components/PopupForm.astro";
import {
  getBlogPosts,
  getCategories,
  getAuthors,
  getFaqs,
  resolveRefs,
} from "../../lib/content.js";

// One page is generated for every published post: /blog/<slug>
export function getStaticPaths() {
  return getBlogPosts().map((post) => ({
    params: { slug: post.fieldData.slug },
    props: { post },
  }));
}

const posts = getBlogPosts().map((post) => ({
  ...post,
  categories: resolveRefs(post.fieldData["blog-categories"], getCategories()),
}));

const { post } = Astro.props;
const f = post.fieldData;

const category = resolveRefs(f["blog-categories"], getCategories())[0];
const author = resolveRefs(f["blog-authors"], getAuthors())[0];
const faqs = resolveRefs(f.faq, getFaqs());

const title = f["meta-title-seo"] || f.name;
const description = f["meta-description-seo"] || f["blog-summary-2"];
const image = f["blog-thumbnail"]?.url;
const url = `https://www.jellypop.design/blog/${f.slug}`;
---

<Layout
  title={title}
  description={description}
  canonicalPath={`/blog/${f.slug}`}
>
  <Fragment slot="head-extra">
    <script
      async
      type="module"
      src="https://cdn.jsdelivr.net/npm/@finsweet/attributes@2/attributes.js"
    ></script>
    <script
      defer
      src="https://cdn.jsdelivr.net/npm/@finsweet/attributes-toc@1/toc.js"
    ></script>
    <style is:global>
      .faq-minus.vertical {
        transition: transform 0.3s ease;
      }
      .faq_item.active .faq-minus.vertical {
        transform: rotate(90deg);
      }
    </style>
    <style is:global>
      .table-wrapper {
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
      }
      .table-wrapper table {
        min-width: 600px;
      }
    </style>
  </Fragment>

  <div class="page-wrapper">
    <div class="main-wrapper overflow-visible">
      <Navbar current="blog" />
      <div class="blog-post-hero-section">
        <div class="padding-global">
          <div class="container-large">
            <div class="blog-post-header_component">
              <div class="w-layout-grid blog-post-header_content">
                <div class="blog-post-header_content-left">
                  <div class="margin-bottom margin-large">
                    <div class="breadcrumb_component">
                      <a class="breadcrumb-link w-inline-block" href="/blog">
                        <div
                          class="blog_breadcrumb_text text-color-shade-black-70 text-weight-medium"
                        >
                          Blog
                        </div>
                      </a>
                      <div class="icon-embed-xxsmall w-embed">
                        <svg
                          fill="none"
                          height="16"
                          viewbox="0 0 16 16"
                          width="16"
                          xmlns="http://www.w3.org/2000/svg"
                        >
                          <path
                            d="M6 3L11 8L6 13"
                            stroke="CurrentColor"
                            stroke-width="1.5"></path>
                        </svg>
                      </div>
                      <a
                        class="breadcrumb-link w-inline-block"
                        href={`/blog/${f.slug}`}
                      >
                        <div
                          class="blog_breadcrumb_text text-color-shade-black-70 text-weight-medium"
                        >
                          {f.name}
                        </div>
                      </a>
                    </div>
                  </div>
                  <div class="margin-bottom margin-medium">
                    <h1 class="heading-style-h1 text-size-xxlarge">{f.name}</h1>
                  </div>
                  <div class="margin-bottom margin-medium">
                    <p class="text-size-medium-2">{f["blog-summary-2"]}</p>
                  </div>
                  <div class="margin-bottom margin-small">
                    <div class="blogs-category_component">
                      <div class="blogs-category_wrapper">
                        <div class="blog-description_tag">
                          <div class="blog-description_text">
                            {category?.fieldData.name}
                          </div>
                        </div>
                      </div>
                      <div class="text-size-medium">{f["read-time"]}</div>
                    </div>
                  </div>
                </div>
                <div class="header1_image-wrapper">
                  <img
                    alt={f["alt-text-blog-cover"] || f.name}
                    class="header1_image"
                    loading="eager"
                    src={image}
                  />
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="blog-post-detail-section">
        <div class="padding-global">
          <div class="container-large">
            <div class="blog-post-detail-section_component">
              <div class="content32_content-left">
                <div class="content32_contributers">
                  <div class="content32_author-list">
                    <div class="margin-bottom margin-small">
                      <div class="content32_author-wrapper">
                        <div class="star-image-wrapper">
                          <img
                            alt={author?.fieldData.name ?? ""}
                            class="content32_author-image"
                            loading="lazy"
                            src={author?.fieldData["profile-picture"]?.url}
                          />
                        </div>
                        <div class="content32_author-details">
                          <div class="text-weight-semibold">
                            {author?.fieldData.name}
                          </div>
                          <div class="author-position_wrapper">
                            <div class="text-size-small">
                              {author?.fieldData.position}
                            </div>
                            <div class="text-size-small">, Jellypop</div>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="content_table">
                  <div class="margin-bottom margin-xsmall">
                    <div class="content_share-text-div">
                      <div
                        class="fst-toc_text-header text-style-allcaps text-color-shade-black-50"
                      >
                        Table of Contents
                      </div>
                    </div>
                  </div>
                  <div class="margin-bottom margin-xsmall">
                    <div class="fs-toc_link-content">
                      <div class="fs-toc_link-wrapper is-h2">
                        <a class="fs-toc_link w-inline-block" href="#">
                          <div
                            class="fs-toc_text"
                            fs-toc-element="link"
                            fs-toc-offsettop="8rem"
                          >
                            H2 Tag
                          </div>
                        </a>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="content_cta-left">
                  <div class="margin-bottom margin-xsmall">
                    <div class="profile_header">
                      <div class="text-size-xlarge text-weight-semibold">
                        Ready to Take the Next Step?
                      </div>
                      <div class="text-size-regular-3 text-color-white-70">
                        Let’s explore how we can help you build better
                        experiences and achieve your goals.
                      </div>
                    </div>
                  </div>
                  <a
                    class="button_primary_fixed-size blog_cta_button button-padding_bottom w-inline-block"
                    data-popup-open=""
                    aria-haspopup="dialog"
                    href="#"
                    rel="nofollow"
                  >
                    <div
                      class="button-text text-color-white button-text_semibold"
                    >
                      Book a Call
                    </div>
                  </a>
                  <div class="text-size-small text-style-italic">
                    ⚡ Get Instant Response
                  </div>
                </div>
              </div>
              <div
                class="content32_content"
                id="w-node-a8eb37c4-80d1-9055-2c13-b5aaab6a2af1-22767732"
              >
                <div class="summary-wrapper_border">
                  <div class="summary-wrapper">
                    <div class="margin-bottom margin-small">
                      <div class="div-block-46">
                        <div class="star-image-wrapper">
                          <img
                            alt="Three small star-shaped sparkles in gradient blue and purple colors on a transparent background."
                            class="icon-1x1-small-2"
                            loading="lazy"
                            src="/images/Group-1948755496_1Group-1948755496.png"
                          />
                        </div>
                        <div
                          class="text-size-large-2 text-weight-medium text-color-shade-black"
                        >
                          Executive Summary
                        </div>
                      </div>
                    </div>
                    <div
                      class="blog-rich-text w-richtext"
                      set:html={f["executive-summary"]}
                    />
                  </div>
                </div>
                <div class="summary-button-wrapper">
                  <div class="summary-button-content">
                    <p
                      class="text-size-large-2 text-color-shade-black text-weight-medium"
                    >
                      Read Summarized Version with
                    </p>
                    <div class="margin-top margin-small">
                      <div class="button-group-4 summary_logo-wrapper">
                        <a
                          class="summary_icon_link-block w-inline-block"
                          href={f["chatgpt-link-2"]}
                          target="_blank"
                          rel="noopener"
                          ><img
                            alt="ChatGPT logo with black text and an abstract geometric symbol on white background."
                            class="summary_wapper-icon"
                            loading="lazy"
                            src="/images/ChatGPT-white-bg-logo.png"
                          />
                          <div class="summary_overlay"></div>
                        </a>
                        <a
                          class="summary_icon_link-block w-inline-block"
                          href={f["perplexity-link-2"]}
                          target="_blank"
                          rel="noopener"
                          ><img
                            alt="Perplexity logo with a geometric star-like icon and black text on a white background."
                            class="summary_wapper-icon"
                            loading="lazy"
                            src="/images/perplexity-white-bg-logo.png"
                            width="Auto"
                          />
                          <div class="summary_overlay"></div>
                        </a>
                        <a
                          class="summary_icon_link-block w-inline-block"
                          href={f["claude-link-2"]}
                          target="_blank"
                          rel="noopener"
                          ><img
                            alt="Claude logo with a rust-colored starburst symbol next to black text on a white background."
                            class="summary_wapper-icon"
                            loading="lazy"
                            src="/images/Claude-white-bg-logo.png"
                          />
                          <div class="summary_overlay"></div>
                        </a>
                        <a
                          class="summary_icon_link-block w-inline-block"
                          href={f["gemini-link-2"]}
                          target="_blank"
                          rel="noopener"
                          ><img
                            alt="Gemini logo with a star dotting the letter i on a white background."
                            class="summary_wapper-icon"
                            loading="lazy"
                            src="/images/Gemini-white-bg-logo.png"
                          />
                          <div class="summary_overlay"></div>
                        </a>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="content_table mobile-version">
                  <div class="margin-bottom margin-xsmall">
                    <div class="content_share-text-div">
                      <div
                        class="fst-toc_text-header text-style-allcaps text-color-shade-black-50"
                      >
                        Table of Contents
                      </div>
                    </div>
                  </div>
                  <div class="margin-bottom margin-xsmall">
                    <div class="fs-toc_link-content">
                      <div class="fs-toc_link-wrapper is-h2">
                        <a class="fs-toc_link w-inline-block" href="#">
                          <div
                            class="fs-toc_text text-color-shade-black-50 black-opacity-100"
                            fs-toc-element="link"
                            fs-toc-offsettop="8rem"
                          >
                            H2 Tag
                          </div>
                        </a>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="blog_post-rich-text-wrapper">
                  <div
                    class="blog-rich-text w-richtext"
                    fs-toc-element="contents"
                    fs-toc-hideurlhash="true"
                    id="content"
                    rel="no-follow"
                    set:html={f["rich-text-field"]}
                  />
                  {
                    faqs.length > 0 && (
                      <div class="faq-wrapper">
                        <h2>FAQ</h2>
                        <div
                          class="w-dyn-list"
                          fs-list-element="wrapper"
                          fs-list-instance="faq"
                        >
                          <div class="w-dyn-items" role="list">
                            {faqs.map((faq) => (
                              <div class="w-dyn-item" role="listitem">
                                <div
                                  class="faq_item w-dropdown"
                                  data-delay="0"
                                  data-hover="false"
                                >
                                  <div class="faq_toggle w-dropdown-toggle">
                                    <div class="faq-question_wrapper">
                                      <div class="faq-question text-color-shade-black">
                                        {faq.fieldData.name}
                                      </div>
                                      <div class="faq-toogler">
                                        <div class="faq-minus" />
                                        <div class="faq-minus vertical" />
                                      </div>
                                    </div>
                                  </div>
                                  <nav class="faq__content w-dropdown-list">
                                    <div class="faq-tab_content">
                                      <div
                                        class="faq_paragraph text-color-shade-black-70 w-richtext"
                                        set:html={faq.fieldData["answer-2"]}
                                      />
                                    </div>
                                  </nav>
                                </div>
                              </div>
                            ))}
                          </div>
                        </div>
                      </div>
                    )
                  }
                  <div class="content_share-wrapper">
                    <div class="content_share-text-div">
                      <div
                        class="text-size-small text-weight-medium text-color-shade-black-50"
                      >
                        SHARE THIS BLOG
                      </div>
                    </div>
                    <div class="w-layout-grid content32_share">
                      <!-- <a
                        class="content32_social-link icon-align-center w-inline-block"
                        fs-socialshare-element="x"
                        href="#"
                      > -->

                      <a
                        class="content32_social-link icon-align-center w-inline-block"
                        href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(url)}&text=${encodeURIComponent(f.name)}`}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        <div class="icon-embed-xsmall w-embed">
                          <svg
                            fill="none"
                            height="16"
                            viewbox="0 0 16 16"
                            width="16"
                            xmlns="http://www.w3.org/2000/svg"
                          >
                            <path
                              d="M9.237 7.004L14.077 1.499H12.93L8.727 6.28L5.371 1.5H1.5L6.575 8.728L1.5 14.499H2.647L7.084 9.452L10.629 14.499H14.5L9.237 7.004ZM7.666 8.791L7.152 8.071L3.06 2.344H4.822L8.124 6.966L8.638 7.686L12.93 13.693H11.169L7.666 8.791Z"
                              fill="black"></path>
                          </svg>
                        </div>
                      </a>
                      <a
                        class="content32_social-link icon-align-center w-inline-block"
                        href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        <div class="icon-embed-xsmall w-embed">
                          <svg
                            fill="none"
                            height="28"
                            viewbox="0 0 28 28"
                            width="28"
                            xmlns="http://www.w3.org/2000/svg"
                          >
                            <path
                              clip-rule="evenodd"
                              d="M8.53304 10.2419C9.48326 10.2419 10.2536 9.47155 10.2536 8.52132C10.2536 7.57109 9.48326 6.80078 8.53304 6.80078C7.58281 6.80078 6.8125 7.57109 6.8125 8.52132C6.8125 9.47155 7.58281 10.2419 8.53304 10.2419ZM11.8293 11.5134H14.6808V12.8197C14.6808 12.8197 15.4546 11.2721 17.5599 11.2721C19.438 11.2721 20.9938 12.1973 20.9938 15.0173V20.964H18.0389V15.7379C18.0389 14.0743 17.1507 13.8914 16.474 13.8914C15.0694 13.8914 14.829 15.1029 14.829 15.9549V20.964H11.8293V11.5134ZM10.0329 11.5134H7.0332V20.964H10.0329V11.5134Z"
                              fill="#000714"
                              fill-rule="evenodd"></path>
                          </svg>
                        </div>
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="blog_similar-posts">
        <div class="padding-global">
          <div class="container-large">
            <div class="blog-similar-posts_wrapper">
              <div class="blog_related_post-heading-wrapper">
                <h2 class="heading-style-h2 text-size-3rem">Related Blogs</h2><a
                  href="/blog"
                  class="button_primary_fixed-size blog_cta_button w-inline-block"
                  ><div
                    class="button-text text-color-white button-text_semibold"
                  >
                    View All
                  </div></a
                >
              </div><div class="padding-bottom padding-xlarge"></div>
              <div
                class="blog-featured-collection_list w-dyn-items"
                role="list"
              >
                {
                  posts
                    .filter((post) => post.fieldData.slug !== f.slug)
                    .slice(0, 3)
                    .map((post) => (
                      <div
                        class="blog-categories-collection_item w-dyn-item"
                        role="listitem"
                      >
                        <a
                          class="blog-categories-item_wrapper w-inline-block"
                          href={`/blog/${post.fieldData.slug}`}
                        >
                          <div class="blog-post-image_wrapper">
                            <img
                              alt={
                                post.fieldData["alt-text-blog-cover"] ||
                                post.fieldData.name
                              }
                              class="blogs_image"
                              loading="lazy"
                              src={post.fieldData["blog-thumbnail"]?.url}
                              style="-webkit-transform:translate3d(0, 0, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-moz-transform:translate3d(0, 0, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-ms-transform:translate3d(0, 0, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);transform:translate3d(0, 0, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0)"
                            />
                          </div>
                          <div class="blogs-description_wrapper">
                            <h2 class="blog-featured-post_heading text-size-1-25rem line-height-130percent">
                              {post.fieldData.name}
                            </h2>
                            <div class="blog-category_wrapper">
                              {post.categories.map((cat) => (
                                <div class="blogs-category_wrapper">
                                  {cat.fieldData.name}
                                </div>
                              ))}
                            </div>
                          </div>
                        </a>
                      </div>
                    ))
                }
              </div>
            </div>
          </div>
        </div>
      </div>
      <Footer current="blog" />
    </div>
    <div>
      <GlobalEmbeds />
      <PopupForm pageId={post.fieldData.slug} />
    </div>
  </div>

  <Fragment slot="scripts-extra">
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        headline: f.name,
        description: description,
        image: image,
        datePublished: f["published-date"] || post.createdOn,
        dateModified: post.lastUpdated,
        mainEntityOfPage: url,
        author: author
          ? { "@type": "Person", name: author.fieldData.name }
          : undefined,
        publisher: { "@type": "Organization", name: "Jellypop Studio" },
      })}
    />
    <script is:inline>
      document.addEventListener("DOMContentLoaded", function () {
        const faqItems = document.querySelectorAll(".faq_item");
        faqItems.forEach((item) => {
          const toggle = item.querySelector(".faq_toggle");
          if (!toggle) return;
          const content = item.querySelector(".faq__content");
          const verticalLine = item.querySelector(".faq-minus.vertical");
          toggle.addEventListener("click", function () {
            const isOpen = toggle.getAttribute("aria-expanded") === "true";
            // Close all FAQs first
            faqItems.forEach((otherItem) => {
              const otherToggle = otherItem.querySelector(".faq_toggle");
              const otherContent = otherItem.querySelector(".faq__content");
              const otherVertical = otherItem.querySelector(
                ".faq-minus.vertical",
              );
              otherToggle.setAttribute("aria-expanded", "false");
              otherContent.style.height = "0px";
              if (otherVertical) {
                otherVertical.style.transform = "rotate(90deg)";
              }
            });
            // Open clicked FAQ if it was closed
            if (!isOpen) {
              toggle.setAttribute("aria-expanded", "true");
              content.style.height = content.scrollHeight + "px";
              if (verticalLine) {
                verticalLine.style.transform = "rotate(0deg)";
              }
            }
          });
        });
      });
    </script>
  </Fragment>
</Layout>
