  }
  /* Apply "..." at 100% width */
  .truncate-width { 
  		width: 100%; 
      white-space: nowrap; 
      overflow: hidden; 
      text-overflow: ellipsis; 
  }
  /* Removes native scrollbar */
  .no-scrollbar {
      -ms-overflow-style: none;
      overflow: -moz-scrollbars-none; 
  }
  .no-scrollbar::-webkit-scrollbar {
      display: none;
  }
