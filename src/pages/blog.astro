---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import GlobalEmbeds from "../components/GlobalEmbeds.astro";
import PopupForm from "../components/PopupForm.astro";
import { getBlogPosts, getCategories, resolveRefs } from "../lib/content.js";

const posts = getBlogPosts().map((post) => ({
  ...post,
  categories: resolveRefs(post.fieldData["blog-categories"], getCategories()),
}));
---

<Layout title="Blog" canonicalPath="/blog">
  <Fragment slot="head-extra">
    <script
      async
      type="module"
      src="https://cdn.jsdelivr.net/npm/@finsweet/attributes@2/attributes.js"
    ></script>
  </Fragment>

  <div class="page-wrapper">
    <div>
      <GlobalEmbeds />
      <PopupForm pageId="6979a8d367b9ec60578308ce" />
      
    </div>
  </div>
  <div class="main-wrapper">
    <Navbar current="blog" />
    <section class="blog-featured-section" data-hero="">
      <div class="padding-global">
        <div class="container-large">
          <div class="blog-featured_wrapper">
            <div class="blog-header_wrapper">
              <h1 class="heading-style-h1 text-color-black">
                Blogs &amp; Articles
              </h1>
              <div class="padding-bottom padding-small"></div>
              <p
                class="text-size-medium text-weight-normal text-color-1f1f1f"
                id="blog-list-top"
              >
                Our team of expert designers and strategists poured their
                insights into a series of articles focusing on design, culture,
                marketing, and technology which is extremely useful for D2C and
                retail brands like yours!
              </p>
            </div>
            <div class="blog-categories-collection-list_wrapper w-dyn-list">
              <div
                class="blog-featured-collection_list w-dyn-items"
                role="list"
              >
                {
                  posts.map((post, i) => (
                    <div
                      class="blog-categories-collection_item w-dyn-item"
                      data-page={Math.floor(i / 6) + 1}
                      role="listitem"
                    >
                      <a
                        class="blog-categories-item_wrapper w-inline-block"
                        href={`/blog/${post.fieldData.slug}`}
                      >
                        <div class="blog-post-image_wrapper">
                          <img
                            alt={
                              post.fieldData["alt-text-blog-cover"] ||
                              post.fieldData.name
                            }
                            class="blogs_image"
                            loading="lazy"
                            src={post.fieldData["blog-thumbnail"]?.url}
                            style="-webkit-transform:translate3d(0, 0, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-moz-transform:translate3d(0, 0, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-ms-transform:translate3d(0, 0, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);transform:translate3d(0, 0, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0)"
                          />
                        </div>
                        <div class="blogs-description_wrapper">
                          <h2 class="blog-featured-post_heading text-size-1-25rem line-height-130percent">
                            {post.fieldData.name}
                          </h2>
                          <div class="blog-category_wrapper">
                            {post.categories.map((cat) => (
                              <div class="blogs-category_wrapper">
                                {cat.fieldData.name}
                              </div>
                            ))}
                          </div>
                        </div>
                      </a>
                    </div>
                  ))
                }
              </div>
              <!-- ADD PAGINATION HERE -->
              <div
                aria-label="List"
                class="w-pagination-wrapper pagination"
                id="blog-pagination"
                role="navigation"
              >
                <a
                  aria-label="Previous Page"
                  class="w-pagination-previous blog_paginate_arrow"
                  href="#"
                  id="blog-prev"
                >
                  <div class="arrow">
                    <div class="icon w-embed">
                      <svg
                        fill="none"
                        height="100%"
                        viewBox="0 0 18 18"
                        width="100%"
                        xmlns="http://www.w3.org/2000/svg"
                      >
                        <path
                          d="M11.25 14.625L5.625 9L11.25 3.375"
                          stroke="currentcolor"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="1.125"></path>
                      </svg>
                    </div>
                  </div>
                  <div class="w-inline-block">Previous</div>
                </a>

                <div class="list_page-buttons" id="blog-page-buttons"></div>

                <a
                  aria-label="Next Page"
                  class="w-pagination-next blog_paginate_arrow"
                  href="#"
                  id="blog-next"
                >
                  <div class="w-inline-block">Next</div>
                  <div class="arrow">
                    <div class="icon w-embed">
                      <svg
                        fill="none"
                        height="100%"
                        viewBox="0 0 18 18"
                        width="100%"
                        xmlns="http://www.w3.org/2000/svg"
                      >
                        <path
                          d="M6.75 3.375L12.375 9L6.75 14.625"
                          stroke="currentcolor"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="1.125"></path>
                      </svg>
                    </div>
                  </div>
                </a>
              </div>
              <!-- END PAGINATION -->
            </div>
          </div>
        </div>
      </div>
    </section>
    <Footer current="blog" />
  </div>

  <script is:inline>
    document.addEventListener("DOMContentLoaded", function () {
      const items = Array.from(document.querySelectorAll("[data-page]"));
      const totalPages = Math.max(
        ...items.map((el) => parseInt(el.dataset.page, 10)),
      );
      const buttonsWrapper = document.getElementById("blog-page-buttons");
      const prevBtn = document.getElementById("blog-prev");
      const nextBtn = document.getElementById("blog-next");
      let currentPage = 1;

      function render() {
        items.forEach((el) => {
          el.style.display =
            parseInt(el.dataset.page, 10) === currentPage ? "" : "none";
        });

        buttonsWrapper.innerHTML = "";
        for (let i = 1; i <= totalPages; i++) {
          const btn = document.createElement("a");
          btn.href = "#";
          btn.className =
            "blog_paginate_link w-inline-block" +
            (i === currentPage ? " w--current" : "");
          btn.innerHTML = `<div>${i}</div>`;
          btn.addEventListener("click", (e) => {
            e.preventDefault();
            currentPage = i;
            render();
            document
              .getElementById("blog-list-top")
              .scrollIntoView({ behavior: "smooth", block: "start" });
          });
          buttonsWrapper.appendChild(btn);
        }

        prevBtn.classList.toggle(
          "is-list-pagination-disabled",
          currentPage === 1,
        );
        nextBtn.classList.toggle(
          "is-list-pagination-disabled",
          currentPage === totalPages,
        );
      }

      prevBtn.addEventListener("click", (e) => {
        e.preventDefault();
        if (currentPage > 1) {
          currentPage--;
          render();
        }
      });
      nextBtn.addEventListener("click", (e) => {
        e.preventDefault();
        if (currentPage < totalPages) {
          currentPage++;
          render();
        }
      });

      render();
    });
  </script>
</Layout>
