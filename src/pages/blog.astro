      --color-scheme-1--border: var(--color-scheme-10--border);
      --color-scheme-1--accent: var(--color-scheme-10--accent);
    }
  /* Inherit slider dot colors */
  .w-slider-dot {
    background-color: var(--color-scheme-1--text);
    opacity: 0.20;
  }
  .w-slider-dot.w-active {
    background-color: var(--color-scheme-1--text);
